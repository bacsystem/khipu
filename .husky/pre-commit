# Pre-commit (#373): si el commit toca archivos del portal, eslint sobre ellos y tsc sobre el proyecto.
# Solo lo rápido: Vitest y e2e quedan para la PR. HUSKY=0 desactiva los hooks (p. ej. al reescribir commits con amend).
# Los archivos se revisan tal como están en el árbol de trabajo, no solo la parte que está en el índice.
git diff --cached --quiet --diff-filter=ACMR -- 'portal/*.ts' 'portal/*.tsx' 'portal/*.js' 'portal/*.mjs' && exit 0

if [ ! -d portal/node_modules ]; then
  echo "husky: portal/node_modules no existe, no se revisó el portal. Corre 'npm --prefix portal ci'." >&2
  exit 0
fi

# -z y --relative: git no escapa las rutas con tilde o ñ (saldrían entre comillas y con octales) y las entrega relativas a portal/,
# donde corre eslint. Separadas por NUL aguantan también los directorios del App Router, que llevan (), [] y ...
git diff --cached --relative=portal --name-only -z --diff-filter=ACMR -- 'portal/*.ts' 'portal/*.tsx' 'portal/*.js' 'portal/*.mjs' | xargs -0 npm --prefix portal run lint -- --no-warn-ignored || exit 1
npm --prefix portal run typecheck || exit 1
