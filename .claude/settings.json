{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "advisorModel": "fable",
  "permissions": {
    "allow": [
      "Bash(./gradlew test)",
      "Bash(./gradlew build)",
      "Bash(./gradlew :bootstrap:test --tests \"*ArchitectureTest*\")",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run test -- --run)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git log --oneline -20)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.preprod)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.dev)",
      "Read(**/.env.qa)",
      "Read(**/.env.stage)",
      "Read(**/.env.bak)",
      "Read(**/.env.*.bak)",
      "Read(**/.env.backup)",
      "Read(**/.env.old)",
      "Read(**/.env.orig)",
      "Read(**/.env.save)",
      "Read(**/.env~)",
      "Read(**/.envrc)",
      "Bash(cat *.env*)",
      "Bash(grep * *.env*)"
    ]
  }
}
