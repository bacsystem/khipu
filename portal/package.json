{
  "name": "khipu-portal",
  "version": "0.2.1",
  "private": true,
  "browserslist": [
    "defaults and supports bigint"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "eslint && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && husky || true",
    "test": "vitest run",
    "audit": "node scripts/auditar-dependencias.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "generate:api": "node scripts/generate-api.mjs",
    "generate:types": "node scripts/generate-api.mjs --solo-tipos"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@scalar/api-reference-react": "^0.9.67",
    "@tanstack/react-query": "^5.102.8",
    "cn": "^0.3.0",
    "khipu-design-system": "github:bacsystem/khipu-design-system#v0.5.0",
    "lucide-react": "^1.45.0",
    "next": "15.5.28",
    "next-intl": "4.4.0",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "use-intl": "4.4.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
