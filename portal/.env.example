API_BASE_URL=http://localhost:8001
# URL de la API que ve el navegador (snippets de integración y "Try it" de /developers) cuando difiere de la
# interna, p. ej. en Docker (API_BASE_URL=http://host.docker.internal:8001). Por defecto es API_BASE_URL.
# API_PUBLIC_URL=https://api.khipu.pe
# Acceso desde otros equipos de la red local en modo dev (IP o nombre de esta máquina, separados por coma).
# PORTAL_DEV_ORIGINS=192.168.18.134
# Soporte (#250), opcionales y vacíos por defecto: sin ellos el portal no muestra «¿Necesitas ayuda?». Un valor mal formado lo
# denuncia el log nombrando la variable, y no se muestra ninguna ayuda hasta corregirlo. SUPPORT_URL tiene que ser https.
# SUPPORT_URL=https://ayuda.khipu.pe
# SUPPORT_EMAIL=soporte@khipu.pe
