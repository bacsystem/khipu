{
  "compilerOptions": {
    // ES2020 (y no el ES2017 del scaffold de Next) por BigInt: `lib/comprobantes/totales.ts` calcula los importes
    // con enteros para igualar al BigDecimal del backend.
    //
    // Esto solo gobierna el chequeo de tipos (`noEmit`). Quién puede *ejecutar* el bundle lo decide el
    // `browserslist` de package.json, y ahí está la parte que importa: **BigInt es sintaxis, no se transpila ni
    // se polirellena**, así que SWC lo emite tal cual y un navegador sin soporte no parsea el chunk. Por eso la
    // consulta es `defaults and supports bigint` y no `defaults` a secas.
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-mock/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
