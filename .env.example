# Puerto HTTP del backend; las plataformas tipo Railway/Heroku lo inyectan. Default: 8001.
PORT=8001
DB_URL=jdbc:postgresql://localhost:5432/factura
DB_USER=factura
DB_PASSWORD=factura
# 32 bytes aleatorios en base64. Generar UNA sola vez y no rotar: cifra certificados y claves SOL almacenados.
# genera un valor: openssl rand -base64 32
MASTER_KEY=
# genera un valor: openssl rand -base64 32
API_KEY_PEPPER=
# genera un valor: openssl rand -base64 32
PLATFORM_ADMIN_KEY=
# fs (disco local, desarrollo) o s3 (S3/MinIO/B2/R2, producción). Ver README §Storage.
STORAGE_TYPE=fs
STORAGE_FS_ROOT=./storage
# Con STORAGE_TYPE=s3. Para el MinIO de docker compose (--profile s3):
#STORAGE_S3_BUCKET=khipu
#STORAGE_S3_REGION=us-east-1
#STORAGE_S3_ENDPOINT=http://localhost:9000
#STORAGE_S3_ACCESS_KEY=khipu
#STORAGE_S3_SECRET_KEY=khipu-minio
#STORAGE_S3_PATH_STYLE=true
# Verificación diaria de integridad del storage: ventana en días e intervalo en ms.
#INTEGRIDAD_DIAS=7
#INTEGRIDAD_INTERVALO_MS=86400000
# Correo. En false (default de desarrollo) NO se envía nada: los correos se escriben en el log
# (LogCorreoSender). **En producción va en true**, si no la recuperación de contraseña y el envío de
# comprobantes al cliente fallan en silencio, sin error visible. Con true, MAIL_HOST es obligatorio.
MAIL_HABILITADO=false
#MAIL_HOST=smtp.tu-proveedor.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_REMITENTE=no-responder@khipu.pe
APP_MODE=multi
# `POST /v1/auth/registro`: cerrado por defecto (issue #174), independiente de si el portal lo cierra.
# En true para desarrollo local; en producción se deja en false hasta certificar el autoservicio.
REGISTRO_ABIERTO=true
