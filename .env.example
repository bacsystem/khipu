# Puerto HTTP del backend; las plataformas tipo Railway/Heroku lo inyectan. Default: 8001.
PORT=8001
DB_URL=jdbc:postgresql://localhost:5432/factura
DB_USER=factura
DB_PASSWORD=factura
# 32 bytes aleatorios en base64. Cifra certificados, claves SOL y secretos del 2FA guardados: no se reemplaza a secas.
# genera un valor: openssl rand -base64 32
MASTER_KEY=
# genera un valor: openssl rand -base64 32
API_KEY_PEPPER=
# Solo durante una rotación (deploy/README.md §9): el valor de antes. Vacíos fuera de una rotación.
#MASTER_KEY_ANTERIOR=
#API_KEY_PEPPER_ANTERIOR=
# genera un valor: openssl rand -base64 32
PLATFORM_ADMIN_KEY=
# Firma los JWT del portal (≥32 bytes). genera un valor: openssl rand -base64 32
JWT_SECRET=
# fs (disco local, desarrollo) o s3 (S3/MinIO/B2/R2, producción). Ver README §Storage.
STORAGE_TYPE=fs
STORAGE_FS_ROOT=./storage
# Con STORAGE_TYPE=s3. Para el MinIO de docker compose (--profile s3):
#STORAGE_S3_BUCKET=khipu
#STORAGE_S3_REGION=us-east-1
#STORAGE_S3_ENDPOINT=http://localhost:9000
#STORAGE_S3_ACCESS_KEY=khipu
#STORAGE_S3_SECRET_KEY=khipu-minio
#STORAGE_S3_PATH_STYLE=true
# Verificación diaria de integridad del storage: ventana en días e intervalo en ms.
#INTEGRIDAD_DIAS=7
#INTEGRIDAD_INTERVALO_MS=86400000
# Monitor del backoffice: horas que un resumen diario o una baja con ticket puede estar sin respuesta de SUNAT antes de marcarse (1 a 168).
#MONITOR_RESUMEN_SIN_RESPUESTA_HORAS=6
# Alertas al operador (deploy/README.md §11). Siempre salen por el log; con estos canales, también por correo o webhook.
#ALERTAS_EMAIL=ops@tu-dominio.pe
#ALERTAS_WEBHOOK_URL=
# Horas máximas sin un respaldo bueno (el cron de deploy/respaldo lo anota). 0 = sin alerta; en producción, 26.
#ALERTAS_RESPALDO_HORAS=26
#ALERTAS_REPETIR_HORAS=24
#ALERTAS_ERROR_ENVIO_MINUTOS=30
#ALERTAS_ERROR_ENVIO_CANTIDAD=5
#ALERTAS_FUERA_DE_PLAZO_HORAS=24
#ALERTAS_INTERVALO_MS=300000
# Hilos de los trabajos programados y tope de tiempo del SMTP.
#SCHEDULER_HILOS=4
#MAIL_TIMEOUT_MS=10000
# Webhooks (deploy/README.md §12). Solo para desarrollo y pruebas: aceptar destinos http y direcciones internas (un receptor en localhost). En producción, en falso.
#WEBHOOKS_PERMITIR_HTTP=false
#WEBHOOKS_PERMITIR_REDES_PRIVADAS=false
#WEBHOOKS_INTERVALO_MS=5000
#WEBHOOKS_HILOS=8
# Correo. En false (default de desarrollo) NO se envía nada: los correos se escriben en el log
# (LogCorreoSender). **En producción va en true**, si no la recuperación de contraseña y el envío de
# comprobantes al cliente fallan en silencio, sin error visible. Con true, MAIL_HOST es obligatorio.
MAIL_HABILITADO=false
#MAIL_HOST=smtp.tu-proveedor.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_REMITENTE=no-responder@khipu.pe
APP_MODE=multi
# `POST /v1/auth/registro`: cerrado por defecto (issue #174), independiente de si el portal lo cierra.
# En true para desarrollo local; en producción se deja en false hasta certificar el autoservicio.
# El docker-compose pasa esta misma variable al backend y al portal (#385): para cerrar el autoservicio en un despliegue, cámbiala aquí y
# recrea los dos servicios. CONTACTO_URL (opcional, `mailto:` o un formulario) es a dónde lleva «Solicitar acceso» en el portal cerrado.
REGISTRO_ABIERTO=true
# IP real del administrador en la bitácora de auditoría (#208). Por defecto no se confía en X-Forwarded-For. No fijar sin calibrar:
# deploy/README.md §5. TRUSTED_PROXIES (backend): regex de las IPs de los proxies de confianza. TRUSTED_PROXY_HOPS (portal): cuántos
# proxies de confianza hay delante del portal; mayor que 0 sin un proxy real delante permite falsificar la IP.
#TRUSTED_PROXIES=
#TRUSTED_PROXY_HOPS=0
# Vida de la sesión del administrador del backoffice, en minutos (#177): entre 5 y 60, o el backend no arranca. Default 30.
#ADMIN_SESION_MINUTOS=30
# API REST de SUNAT con OAuth2 (#318): la consulta de validez con las credenciales API SUNAT de cada empresa. Los valores por defecto son los de SUNAT;
# SUNAT no publica una instancia de pruebas de esta consulta, así que las *_BETA_URL apuntan por defecto a las mismas. Tope de cada llamada en segundos (1 a 120).
#SUNAT_API_SEGURIDAD_URL=https://api-seguridad.sunat.gob.pe
#SUNAT_API_SEGURIDAD_BETA_URL=https://api-seguridad.sunat.gob.pe
#SUNAT_API_CONSULTA_URL=https://api.sunat.gob.pe
#SUNAT_API_CONSULTA_BETA_URL=https://api.sunat.gob.pe
#SUNAT_API_TIMEOUT_SECONDS=10
# SOLO PARA PRUEBAS (#363): duración ISO-8601 que mueve el reloj del backend (p. ej. -P8D = ocho días antes) para reproducir plazos de SUNAT que dependen de la fecha.
# Vacío = hora real. Con valor, el backend no arranca si hay empresas en PRODUCCION y no opera con las que pasen a serlo. Qué se mueve y qué no: deploy/README.md sección 10.
#RELOJ_DESPLAZAMIENTO=
# Padrón de RUC de SUNAT (#361): la búsqueda por RUC del portal y el rechazo de un comprador inexistente (#378) lo necesitan. Apagado por defecto: la carga baja ~400 MB y escribe ~18 millones
# de filas. Con true corre cada día a las 04:30 (hora de Lima); para la primera carga pon PADRON_RUC_CRON en un minuto cercano y vuelve a quitarlo (deploy/README.md, «Padrón reducido de SUNAT»).
# El docker-compose pasa estas variables al backend (#390).
#PADRON_RUC_HABILITADO=true
#PADRON_RUC_CRON=0 30 4 * * *
# Con el archivo del padrón ya en disco (docker compose): la carpeta del host y la ruta dentro del contenedor, en vez de la descarga de SUNAT.
#PADRON_RUC_DIR=D:/ruta/a/la/carpeta
#PADRON_RUC_ORIGEN=/padron/padron_reducido_ruc.txt
